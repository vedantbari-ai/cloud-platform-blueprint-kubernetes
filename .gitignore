# =========================
# Terragrunt
# =========================
# Ignore the temporary working directories generated by Terragrunt
.terragrunt-cache/

# Ignore debug logs generated when Terragrunt crashes
terragrunt-debug.log

# Ignore auto-generated tfvars files passed from Terragrunt to Terraform
.terragrunt-null-vars.auto.tfvars.json
*.auto.tfvars.json

# =========================
# Terraform
# =========================
# Ignore local Terraform initialization folders (contains downloaded providers/modules)
**/.terraform/*

# Ignore local state files (State should ONLY be in your S3 buckets)
*.tfstate
*.tfstate.*

# Ignore crash logs
crash.log
crash.*.log

# Ignore override files (used for local testing only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =========================
# AWS / Security
# =========================
# Prevent accidental commits of AWS credential files if temporarily placed in the repo
.aws/
*.pem
*.key

# =========================
# IDEs and Editors
# =========================
# VS Code
.vscode/
!.vscode/settings.json # (Optional: remove the '!' if you don't want to share workspace settings)

# IntelliJ / JetBrains
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~

# =========================
# OS Generated Files
# =========================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# Project Specific Artifacts
# =========================
# Ignore previously generated zip files or test artifacts
*.zip
client_a_infra_config.zip