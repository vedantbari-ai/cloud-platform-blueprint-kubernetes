      },
      "Action": "sts:AssumeRole"
    }
  ]
}


{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::680736395115:user/vedant.bari"
      },
      "Action": "sts:AssumeRole"
    }
