}

{
  "Version": "2012-10-17",
  "Statement": [
      {
          "Effect": "Allow",
          "Principal": {
              "AWS": "arn:aws:iam::680736395115:group/Terraform-Deployers"
          },
          "Action": "sts:AssumeRole"
      }
